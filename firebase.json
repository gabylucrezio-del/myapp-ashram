{
  "functions": [
    {
      "codebase": "default",
      "source": "functions"
    },
    {
      "source": "functions-ganesha",
      "codebase": "ganesha",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/ganesha-chat",
        "function": "ganeshaChat"
      },
      {
        "source": "/api/english-teacher",
        "function": "englishTeacher"
      },
      {
        "source": "/api/ganesha-transform-document",
        "function": "ganeshaTransformDocument"
      },
      {
        "source": "/api/analytics-event",
        "function": "recordAnalyticsEvent"
      },
      {
        "source": "/api/analytics-diagnostics",
        "function": "analyticsDiagnostics"
      },
      {
        "source": "/api/library-diagnostics",
        "function": "libraryDiagnostics"
      },
      {
        "source": "/api/delete-user",
        "function": "deleteUserAccount"
      },
      {
        "source": "/producto/**",
        "function": "productSharePage"
      },
      {
        "source": "/api/generate-weekly-store-report",
        "function": "generateWeeklyStoreReportTest"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
